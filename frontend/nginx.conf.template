server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  absolute_redirect off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript image/svg+xml application/xml text/plain;

  # Vite puts a content hash in every asset name, so browsers may keep them forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # The page itself must revalidate so a deploy shows up at once.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ =404;
  }
}
